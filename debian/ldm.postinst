#! /bin/sh

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>

case "$1" in
    configure)
	update-alternatives \
		--install /usr/share/ldm/themes/default \
		ldm-theme /usr/share/ldm/themes/ltsp 50

	# Register ldm as the display manager, both the legacy way (some
	# scripts, including ltsp6's own init-ltsp.d/50-default-display-manager
	# hook, still read this file) and via the systemd alias symlink
	# (dh_installsystemd sets this up from ldm.service's "Alias=
	# display-manager.service", but only if no OTHER display manager is
	# already registered - don't clobber an existing choice).
	if [ ! -e /etc/X11/default-display-manager ]; then
		echo /usr/sbin/ldm > /etc/X11/default-display-manager
	fi
       ;;

    abort-upgrade|abort-remove|abort-deconfigure)

    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
