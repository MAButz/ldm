[Unit]
Description=LTSP Display Manager
Conflicts=getty@tty7.service
After=systemd-user-sessions.service getty@tty7.service plymouth-quit.service systemd-logind.service
Wants=systemd-user-sessions.service
# ExecStart below is in ltsp-client-core, which this package does not depend
# on. Without this the unit fails on any host that has ldm but not LTSP,
# once per restart, for as long as systemd keeps trying.
ConditionPathExists=/usr/share/ltsp/screen_session

[Service]
# screen_session sets up XAUTHORITY/DISPLAY and execs `xinit ... /usr/sbin/ldm -- Xorg ...`
# (see /usr/share/ltsp/screen.d/ldm); running /usr/sbin/ldm directly here would skip
# starting Xorg entirely - ldm reads DISPLAY from the environment (src/ldm.c) and never
# starts a server itself, so it dies with "cannot open display" and then SIGSEGVs.
# "07" is the default SCREEN_07=ldm mapping (VT7, the classic graphical-VT convention),
# see ltsp_config.d/15default-screen, which also sets SCREEN_07_WAIT_FGCONSOLE=False so
# screen_session does not sit waiting for VT7 to become the foreground console.
ExecStart=/usr/share/ltsp/screen_session 07
Restart=on-failure
IgnoreSIGPIPE=no
KillMode=mixed
UtmpIdentifier=tty7
UtmpMode=user
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal

[Install]
Alias=display-manager.service
